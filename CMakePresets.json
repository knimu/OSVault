{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-default",
      "displayName": "Windows Visual Studio Default",
      "description": "Visual Studio 64-bit generator with C++17",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows Visual Studio Debug",
      "description": "Visual Studio 64-bit Debug build with C++17",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build_debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "windows-default",
      "configuration": "Release"
    },
    {
      "name": "debug",
      "configurePreset": "windows-debug",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "all-tests",
      "configurePreset": "windows-default",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
